# =============================================================================
# AI Visual Generator — Environment Configuration (Template)
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is in .gitignore.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- AI Provider Configuration ---
# AI_PROVIDER: openai (requires OPENAI_API_KEY), or mock (no API key needed,
# deterministic mock for local dev/testing).
AI_PROVIDER=mock                    # e.g. openai, mock
TEXT_MODEL=                         # e.g. gpt-4o-mini, claude-3-5-sonnet-20241022
IMAGE_PROVIDER=               # e.g. openai, stability, bedrock, local
IMAGE_MODEL=                  # e.g. dall-e-3, sdxl, etc.

# --- Provider API Keys (add as needed) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
STABILITY_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Database ---
DATABASE_URL=
MAX_AGENT_RETRIES=3

# --- Storage ---
STORAGE_BACKEND=local         # local, s3, gcs, azure
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
